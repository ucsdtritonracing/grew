  <property name="styleSheet">
   <string notr="true">/* =========================
   MAIN WINDOW STYLE
   Same dark dashboard theme
   ========================= */

/* Whole app background */
QMainWindow,
QWidget {
    background-color: #07061e;
    color: white;
    font-family: Optima;
    font-size: 14px;
}

/* Main title */
QLabel#titleLabel {
    color: #ffffff;
    font-size: 42px;
    font-weight: bold;
    letter-spacing: 3px;
}

/* Subtitle */
QLabel#subtitleLabel {
    color: #e6e5db;
    font-size: 18px;
    font-weight: bold;
}

/* Normal labels */
QLabel {
    color: white;
    font-size: 14px;
}

/* Big navigation buttons for Main Window */
QPushButton {
    background-color: #07061e;
    color: #ffffff;
    border: 1px solid #121f35;
    border-radius: 14px;
    padding: 12px 22px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #fff08a;
    color: #07061e;
    border: 1px solid #fff08a;
}

QPushButton:pressed {
    background-color: #d6c75c;
    color: #07061e;
}

/* Dashboard cards / sections */
QGroupBox {
    background-color: #07061e;
    border: 1px solid #121f35;
    border-radius: 18px;
    margin-top: 18px;
    padding: 18px;
    color: white;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 6px;
    color: #e6e5db;
}

/* Input boxes */
QLineEdit,
QSpinBox,
QDoubleSpinBox {
    background-color: #11102a;
    color: white;
    border: 1px solid #1d2b46;
    border-radius: 6px;
    padding: 4px;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #fff08a;
}

/* Tab widget background */
QTabWidget::pane {
    background-color: #07061e;
    border: 1px solid #121f35;
    border-radius: 10px;
}

/* Tab bar */
QTabBar::tab {
    background-color: #07061e;
    color: white;
    border: 1px solid #121f35;
    padding: 10px 24px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    margin-right: 4px;
}

QTabBar::tab:selected {
    background-color: #121f35;
    color: #fff08a;
}

QTabBar::tab:hover {
    background-color: #1d2b46;
}

/* Scroll bars */
QScrollBar:vertical {
    background-color: #071427;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #fff08a;
    border-radius: 6px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #071427;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #fff08a;
    border-radius: 6px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}</string>
