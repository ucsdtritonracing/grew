  <property name="styleSheet">
   <string notr="true">/* Main app background */
QMainWindow,
QWidget {
    background-color: #061427;
    color: white;
    font-family: Arial;
    font-size: 14px;
}

/* Main title labels */
QLabel#titleLabel {
    color: white;
    font-size: 42px;
    font-weight: bold;
    letter-spacing: 3px;
}

QLabel#subtitleLabel {
    color: #f6e16b;
    font-size: 18px;
    font-weight: bold;
}

/* Normal labels */
QLabel {
    color: white;
    font-size: 14px;
}

/* Buttons */
QPushButton {
    background-color: #f6e16b;
    color: #061B3A;
    border: none;
    border-radius: 10px;
    padding: 10px 18px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #fff08a;
}

QPushButton:pressed {
    background-color: #d6c75c;
}

/* Text input boxes */
QLineEdit {
    background-color: #0b1c36;
    color: white;
    border: 1px solid rgba(246, 225, 107, 90);
    border-radius: 8px;
    padding: 7px;
}

QLineEdit:focus {
    border: 2px solid #f6e16b;
}

/* Dropdowns */
QComboBox {
    background-color: #0b1c36;
    color: white;
    border: 1px solid rgba(246, 225, 107, 90);
    border-radius: 8px;
    padding: 7px;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #0b1c36;
    color: white;
    selection-background-color: #f6e16b;
    selection-color: #061B3A;
}

/* Tables */
QTableWidget {
    background-color: #0b1c36;
    alternate-background-color: #102747;
    color: white;
    gridline-color: #263b5c;
    border: 1px solid rgba(246, 225, 107, 80);
    border-radius: 10px;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget::item:selected {
    background-color: #f6e16b;
    color: #061B3A;
}

/* Table headers */
QHeaderView::section {
    background-color: #071427;
    color: #f6e16b;
    padding: 7px;
    border: 1px solid #263b5c;
    font-weight: bold;
}

/* Group boxes = dashboard cards */
QGroupBox {
    background-color: rgba(8, 24, 50, 210);
    border: 1px solid rgba(246, 225, 107, 90);
    border-radius: 14px;
    margin-top: 18px;
    padding: 14px;
    color: white;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 6px;
    color: #f6e16b;
}

/* List widgets */
QListWidget {
    background-color: #0b1c36;
    color: white;
    border: 1px solid rgba(246, 225, 107, 80);
    border-radius: 10px;
    padding: 6px;
}

QListWidget::item {
    padding: 8px;
    border-radius: 6px;
}

QListWidget::item:selected {
    background-color: #f6e16b;
    color: #061B3A;
}

/* Scroll bars */
QScrollBar:vertical {
    background-color: #071427;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #f6e16b;
    border-radius: 6px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Check boxes */
QCheckBox {
    color: white;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:checked {
    background-color: #f6e16b;
    border: 1px solid #f6e16b;
}

QCheckBox::indicator:unchecked {
    background-color: #0b1c36;
    border: 1px solid #f6e16b;
}

</string>
